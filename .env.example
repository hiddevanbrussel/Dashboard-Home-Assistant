DATABASE_URL="file:./prisma/dev.db"
# Generate with: openssl rand -hex 32
# The app refuses to start if this is missing, short, or still a placeholder.
APP_SECRET="replace-with-openssl-rand-hex-32"
# Password for tablets that open port 3000 directly. At least 12 characters.
# Home Assistant ingress does not ask for this password.
DASHBOARD_PASSWORD="replace-with-a-long-passphrase"
NEXT_PUBLIC_APP_NAME="Home Assistant Dashboard Builder"
# Default UI language: en (English) or nl (Dutch). Users can override in Settings.
NEXT_PUBLIC_DEFAULT_LANGUAGE="en"

# Pexels API key for screensaver photos (free at pexels.com/api)
PEXELS_API_KEY=""

# Optional public origin for Home Assistant login (IndieAuth client_id).
# Example: https://dashboard.example.com
# APP_PUBLIC_ORIGIN=""

# Set to 1 behind your own reverse proxy so X-Forwarded-Proto and the client IP are trusted.
# The Home Assistant add-on does not need this; it sets HA_ADDON=1.
# TRUST_PROXY=1

# Optional comma-separated hosts allowed for a doorbell WebRTC page that is not on the local network.
# DOORBELL_ALLOWED_HOSTS=""

# Optional passcode for Settings → Install update. Must be at least 20 characters.
# Leave unset to keep that button disabled. Prefer updating the container image instead.
# UPDATE_PASSCODE=""
