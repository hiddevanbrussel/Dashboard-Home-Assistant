{
  "energy_sources": [
    {
      "type": "grid",
      "flow_from": [{ "stat_energy_from": "sensor.grid_import" }],
      "flow_to": [{ "stat_energy_to": "sensor.grid_export" }],
      "power": [
        {
          "stat_rate": "sensor.grid_power_net",
          "power_config": {
            "stat_rate_inverted": "sensor.grid_power_raw",
            "unknown_power": true
          }
        }
      ],
      "cost_adjustment_day": 0.35
    },
    {
      "type": "battery",
      "stat_energy_from": "sensor.battery_out",
      "stat_energy_to": "sensor.battery_in",
      "power_config": { "stat_rate": "sensor.battery_power" }
    }
  ],
  "device_consumption": [{ "stat_consumption": "sensor.fridge" }]
}
